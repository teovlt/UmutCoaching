---
// /programmes/[slug] — docs/02-architecture.md: hero (title, for whom,
// format, duration) → included → schedule → linked price → FAQ → CTA.
// A hidden or unknown programme answers the 404 page.
import CtaBand from "@/components/sections/CtaBand.astro";
import Faq from "@/components/sections/Faq.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import PricingCard from "@/components/ui/PricingCard.astro";
import ProgrammePhoto from "@/components/ui/ProgrammePhoto.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import SquareList from "@/components/ui/SquareList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getFaqs, getProgramme, getSettings } from "@/lib/api";
import { priceText, pricingConditions } from "@/lib/format";
import { localePath } from "@/i18n/config";
import { ui } from "@/i18n/ui";

const slug = Astro.params.slug ?? "";
const { lang } = Astro.locals;
const t = ui[lang];
const [programme, faqs, settings] = await Promise.all([getProgramme(slug, lang), getFaqs(slug, lang), getSettings(lang)]);
if (!programme) return Astro.rewrite(localePath(lang, "/404"));
const copy = {
  fr: {
    audience: "Pour qui",
    format: "Format",
    duration: "Durée",
    price: "Tarif",
    description: (title: string) => `${title} : coaching musculation umut., bilan de départ et programme ajusté chaque semaine.`,
    all: "tous les programmes",
    includedLabel: "inclus",
    included: "Ce qui est inclus.",
    stepsLabel: "déroulé",
    steps: "Déroulé.",
    priceLabel: "tarif",
    priceTitle: "Tarif.",
    compare: "comparer les tarifs",
  },
  en: {
    audience: "Who it's for",
    format: "Format",
    duration: "Duration",
    price: "Price",
    description: (title: string) => `${title}: umut. strength coaching, starting assessment and a programme adjusted every week.`,
    all: "all programmes",
    includedLabel: "included",
    included: "What's included.",
    stepsLabel: "how it works",
    steps: "How it works.",
    priceLabel: "price",
    priceTitle: "Price.",
    compare: "compare prices",
  },
  tr: {
    audience: "Kimler için",
    format: "Format",
    duration: "Süre",
    price: "Fiyat",
    description: (title: string) => `${title}: umut. fitness koçluğu, başlangıç değerlendirmesi ve her hafta güncellenen program.`,
    all: "tüm programlar",
    includedLabel: "dahil",
    included: "Neler dahil.",
    stepsLabel: "süreç",
    steps: "Süreç.",
    priceLabel: "fiyat",
    priceTitle: "Fiyat.",
    compare: "fiyatları karşılaştır",
  },
}[lang];

const p = programme;
const facts = [
  { label: copy.audience, value: p.audience, text: true },
  { label: copy.format, value: t.formats[p.format], text: false },
  { label: copy.duration, value: p.duration, text: false },
  { label: copy.price, value: priceText(p, lang), text: false },
].filter((f) => f.value);

// Sections are numbered in reading order, skipping the empty ones
const shown = [p.includes.length > 0 && "inclus", p.steps.length > 0 && "deroule", "tarif", faqs.length > 0 && "faq", "cta"].filter(
  (id): id is string => Boolean(id),
);
const number = (id: string) => String(shown.indexOf(id) + 1).padStart(2, "0");

const pageUrl = new URL(localePath(lang, `/programmes/${p.slug}`), Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: p.title,
  description: p.summary || undefined,
  url: pageUrl,
  provider: { "@id": `${new URL("/", Astro.site).href}#coach` },
  ...(typeof p.priceFrom === "number" && !p.priceLabel
    ? { offers: { "@type": "Offer", price: p.priceFrom, priceCurrency: p.currency, description: priceText(p, lang) } }
    : {}),
};
---

<BaseLayout title={p.title} description={p.summary || copy.description(p.title)} jsonLd={jsonLd}>
  <PageHeader index="02" label={t.sectionLabels.programmes} title={p.title} lead={p.summary || undefined}>
    <div class="flex flex-col gap-8">
      <dl class="grid gap-x-8 gap-y-4 border-t border-graphite pt-5 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((fact) => (
          <div class="flex flex-col gap-1">
            <dt class="label-mono text-mesure">{fact.label}</dt>
            <dd class:list={[fact.text ? "text-small" : "font-mono font-bold"]}>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href={localePath(lang, "/reserver")} icon="arrow">
          {t.booking}
        </Button>
        <Button variant="ghost" href={localePath(lang, "/programmes")}>
          {copy.all}
        </Button>
      </div>
    </div>
  </PageHeader>

  {p.includes.length > 0 && (
    <section class="section" aria-labelledby="inclus-title">
      <div class="container-site grid gap-8 lg:grid-cols-12">
        <div class="flex flex-col gap-4 lg:col-span-5">
          <SectionLabel index={number("inclus")} label={copy.includedLabel} />
          <h2 id="inclus-title" class="text-h2">
            {copy.included}
          </h2>
          <ProgrammePhoto programme={p} loading="eager" sizes="(min-width: 1024px) 40vw, 100vw" class="mt-4 border border-line" />
        </div>
        <div class="border-t border-graphite pt-6 lg:col-span-6 lg:col-start-7">
          <SquareList items={p.includes} tone="cobalt" />
        </div>
      </div>
    </section>
  )}

  {p.steps.length > 0 && (
    <section class="section border-y border-line bg-white" aria-labelledby="deroule-title">
      <div class="container-site flex flex-col gap-10">
        <div class="flex flex-col gap-4">
          <SectionLabel index={number("deroule")} label={copy.stepsLabel} />
          <h2 id="deroule-title" class="text-h2">
            {copy.steps}
          </h2>
        </div>
        <ol data-stagger class="flex flex-col border-t border-graphite">
          {p.steps.map((step, i) => (
            <li class="grid gap-2 border-b border-line py-5 sm:grid-cols-12 sm:gap-8">
              <span class="font-mono text-label font-bold sm:col-span-3">{step.label || String(i + 1).padStart(2, "0")}</span>
              <p class="text-mesure sm:col-span-9">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="tarif-title">
    <div class="container-site grid gap-8 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <SectionLabel index={number("tarif")} label={copy.priceLabel} />
        <h2 id="tarif-title" class="text-h2">
          {copy.priceTitle}
        </h2>
        <ul class="flex flex-col gap-2 font-mono text-label text-mesure">
          {pricingConditions(settings, lang).map((condition) => (
            <li>{condition}</li>
          ))}
        </ul>
        <div>
          <Button variant="ghost" href={localePath(lang, "/tarifs")}>
            {copy.compare}
          </Button>
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <PricingCard programme={p} />
      </div>
    </div>
  </section>

  <Faq faqs={faqs} index={number("faq")} />
  <CtaBand index={number("cta")} />
</BaseLayout>
