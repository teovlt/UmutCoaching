const digits = isPlaceholder(settings.phone) ? "" : settings.phone.replace(/[^\d+]/g, "");
// "06 31…" → "33631…" for wa.me, which wants the international number without "+"
const whatsapp = digits && `https://wa.me/${digits.replace(/^\+/, "").replace(/^0/, "33")}`;
const contacts = [
  whatsapp && { label: "WhatsApp", value: settings.phone, href: whatsapp, external: true },
  digits && { label: copy.phone, value: settings.phone, href: `tel:${digits}`, external: false },
  !isPlaceholder(settings.email) && { label: copy.email, value: settings.email, href: `mailto:${settings.email}`, external: false },
].filter((c): c is { label: string; value: string; href: string; external: boolean } => Boolean(c));

const steps = copy.steps.map((step, i) => ({ ...step, index: String(i + 1).padStart(2, "0") }));

// Goals Umut works on (docs/04-contenu.md § Programmes, publics). The value
// sent stays the French label whatever the page's language: Umut reads it in /admin
const frenchGoals = ["Perte de poids", "Prise de poids", "Prise de muscle", "Gain de force", "Posture", "Coaching en ligne", "Autre"];
const goals = copy.goals.map((label, i) => ({ value: frenchGoals[i] ?? label, label }));
---

<BaseLayout title={copy.title} description={copy.description}>
  <PageHeader index="05" label={copy.label} title={copy.heading} lead={copy.lead} />

  <section class="section">
    <div class="container-site grid items-start gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="flex flex-col gap-12 lg:col-span-5">
        <div class="flex flex-col gap-6">
          <SectionLabel index="01" label={copy.stepsLabel} as="h2" />
          <ol data-stagger class="flex flex-col border-t border-graphite">
            {steps.map((step) => (
              <li class="flex gap-5 border-b border-line py-5">
                <span class="font-mono text-label font-bold">{step.index}</span>
                <div class="flex flex-col gap-1">
                  <h3 class="font-bold">{step.title}</h3>
                  <p class="text-small text-mesure">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="flex flex-col gap-6">
          <SectionLabel index="02" label={copy.directLabel} as="h2" />
          <ul class="flex flex-col border-t border-graphite">
            {contacts.map((c) => (
              <li class="border-b border-line">
                <a
                  href={c.href}
                  class="flex min-h-14 flex-wrap items-center justify-between gap-x-4 py-3 text-graphite no-underline hover:underline"
                  {...(c.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  <span class="label-mono text-mesure">{c.label}</span>
                  <span class="font-mono text-small font-bold">{c.value}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="font-mono text-label text-mesure">{settings.hours}</p>
          {settings.bookingUrl && (
            <div>
              <Button variant="ghost" href={settings.bookingUrl} attrs={{ target: "_blank", rel: "noopener" }}>
                {copy.agenda}
              </Button>
            </div>
          )}
        </div>
      </div>

      <div id="contact" class="card scroll-mt-24 p-6 sm:p-8 lg:col-span-6 lg:col-start-7">
        <form
          data-contact
          action="/api/messages"
          method="post"
          novalidate
          class="flex flex-col gap-6"
          aria-labelledby="form-title"
          data-msg-required={copy.msgRequired}
          data-msg-email={copy.msgEmail}
          data-msg-failed={copy.msgFailed}
          data-msg-sent={copy.msgSent}
          data-msg-sending={copy.msgSending}
          data-msg-too-many={copy.msgTooMany}
        >
          <div class="flex flex-col gap-2">
            <SectionLabel index="03" label={copy.formLabel} />
            <h2 id="form-title" class="text-h3">
              {copy.formTitle}
            </h2>
            <p class="font-mono text-micro text-mesure">{copy.required}</p>
          </div>
          <Field label={copy.name} name="name" required autocomplete="name" />
          <Field label={copy.email} name="email" type="email" required autocomplete="email" help={copy.emailHelp} />
          <Field label={copy.phone} name="phone" type="tel" autocomplete="tel" help={copy.phoneHelp} />
          <Field label={copy.goal} name="goal" as="select" placeholder={copy.goalPlaceholder} options={goals} />
          <Field label={copy.message} name="message" as="textarea" required rows={5} />
          <!-- Honeypot: hidden from people and assistive tech, filled by bots -->
          <div class="hidden" aria-hidden="true">
            <label for="field-website">{copy.website}</label>
            <input id="field-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p class="text-small text-mesure">
            {copy.privacyBefore}
            <a href={localePath(lang, "/confidentialite")}>{copy.privacyLink}</a>.
          </p>
          <div class="flex flex-col gap-4">
            <div>
              <Button type="submit" icon="arrow">
                {copy.send}
              </Button>
            </div>
            <p data-form-status role="status" class="font-mono text-small empty:hidden"></p>
          </div>
          <noscript>
            <p class="font-mono text-small text-mesure">{copy.noscript}</p>
          </noscript>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Contact form: field checks with the microcopy of docs/04-contenu.md, then
  // a JSON POST to /api/messages (same origin: nginx, or Vite's proxy in dev).

  type Control = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const setError = (control: Control, message: string) => {
    const id = `${control.id}-error`;
    let error = document.getElementById(id);
    const help =
      control
        .getAttribute("aria-describedby")
        ?.split(" ")
        .filter((d) => d !== id) ?? [];
    if (!message) {
      error?.remove();
      control.removeAttribute("aria-invalid");
      control.classList.replace("border-danger", "border-graphite");
      if (help.length) control.setAttribute("aria-describedby", help.join(" "));
      else control.removeAttribute("aria-describedby");
      return;
    }
    if (!error) {
      error = document.createElement("p");
      error.id = id;
      error.className = "font-mono text-micro text-danger";
      (control.closest(".relative") ?? control).after(error);
    }
    error.textContent = message;
    control.setAttribute("aria-invalid", "true");
    control.classList.replace("border-graphite", "border-danger");
    control.setAttribute("aria-describedby", [id, ...help].join(" "));
  };

  // Messages in the page's language, from the form's data-msg-* attributes
  type Messages = { required: string; email: string; failed: string; sent: string; sending: string; tooMany: string };
  const messagesOf = (form: HTMLFormElement): Messages => {
    const d = form.dataset;
    return {
      required: d.msgRequired ?? "",
      email: d.msgEmail ?? "",
      failed: d.msgFailed ?? "",
      sent: d.msgSent ?? "",
      sending: d.msgSending ?? "",
      tooMany: d.msgTooMany ?? "",
    };
  };

  const check = (control: Control, msg: Messages): boolean => {
    const value = control.value.trim();
    let message = "";
    if (control.required && !value) message = msg.required;
    else if (control.type === "email" && value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) message = msg.email;
    setError(control, message);
    return !message;
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-contact]")) {
    const status = form.querySelector<HTMLElement>("[data-form-status]") as HTMLElement;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]') as HTMLButtonElement;
    const controls = [...form.querySelectorAll<Control>("input:not([name=website]), textarea, select")];
    const msg = messagesOf(form);

    // Re-check a field once it has been flagged, as the user corrects it
    for (const control of controls) {
      control.addEventListener("blur", () => control.hasAttribute("aria-invalid") && check(control, msg));
      control.addEventListener("input", () => control.hasAttribute("aria-invalid") && check(control, msg));
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const invalid = controls.filter((control) => !check(control, msg));
      if (invalid.length) {
        invalid[0]?.focus();
        return;
      }

      submit.disabled = true;
      status.className = "font-mono text-small text-mesure";
      status.textContent = msg.sending;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!res.ok) {
          // 429: too many messages from this address
          throw new Error(res.status === 429 ? msg.tooMany : msg.failed);
        }
        form.reset();
        status.className = "font-mono text-small font-bold text-success";
        status.textContent = msg.sent;
      } catch (err) {
        status.className = "font-mono text-small text-danger";
        // A TypeError is a network failure: no message worth showing
        status.textContent = err instanceof Error && !(err instanceof TypeError) ? err.message : msg.failed;
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
