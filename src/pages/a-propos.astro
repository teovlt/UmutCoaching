---
// /a-propos — title, text, tags and photo edited in /admin. No diploma is
// shown until Umut confirms it (Q13): the field stays a visible placeholder.
import CtaBand from "@/components/sections/CtaBand.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import PhotoPlaceholder from "@/components/ui/PhotoPlaceholder.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Tag from "@/components/ui/Tag.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSettings } from "@/lib/api";

const settings = await getSettings();
const { about, photos, legal } = settings;
const title = about.title || "Umut, coach musculation.";
const text = about.text || "[À CONFIRMER] Parcours d'Umut en 3 à 5 lignes, et pourquoi il coache.";

// Formats and languages: src/data/site.ts (confirmed Q3, Q8)
const facts = [
  { label: "Lieu", value: `${settings.city} · ${settings.gym}` },
  { label: "Formats", value: settings.formats },
  { label: "Langues de coaching", value: settings.languages },
  { label: "Diplôme et carte pro", value: legal.qualification },
];
---

<BaseLayout
  title="À propos"
  description="Umut, coach musculation et bodybuilding : spécialités force, prise de masse et sèche, coaching en salle et en ligne, en français, turc ou anglais."
>
  <PageHeader index="04" label="à propos" title={title} />

  <section class="section" aria-labelledby="parcours-title">
    <div class="container-site grid items-start gap-10 lg:grid-cols-12 lg:gap-8">
      {photos.about.url ? (
        <img
          src={photos.about.url}
          alt={photos.about.alt || "Umut à la salle"}
          width="800"
          height="1000"
          loading="eager"
          decoding="async"
          class="aspect-[4/5] w-full border border-line object-cover sm:max-w-sm lg:col-span-5 lg:max-w-none"
        />
      ) : (
        <PhotoPlaceholder label="portrait d'Umut" class="sm:max-w-sm lg:col-span-5 lg:max-w-none" />
      )}
      <div class="flex flex-col gap-6 lg:col-span-6 lg:col-start-7">
        <SectionLabel index="01" label="parcours" />
        <h2 id="parcours-title" class="sr-only">
          Parcours
        </h2>
        <p class="max-w-[62ch] text-lead whitespace-pre-line">{text}</p>
        {about.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label="Spécialités">
            {about.tags.map((tag) => (
              <li>
                <Tag>#{tag}</Tag>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <section class="section border-y border-line bg-white" aria-labelledby="fiche-title">
    <div class="container-site grid gap-8 lg:grid-cols-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <SectionLabel index="02" label="fiche" />
        <h2 id="fiche-title" class="text-h2">
          En bref.
        </h2>
      </div>
      <dl class="flex flex-col border-t border-graphite lg:col-span-6 lg:col-start-7">
        {facts.map((fact) => (
          <div class="grid gap-1 border-b border-line py-4 sm:grid-cols-12 sm:gap-6">
            <dt class="label-mono text-mesure sm:col-span-5">{fact.label}</dt>
            <dd class="font-mono text-small sm:col-span-7">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="methode-lien-title">
    <div class="container-site flex flex-col gap-6">
      <SectionLabel index="03" label="méthode" />
      <h2 id="methode-lien-title" class="max-w-[22ch] text-h2">
        Mesurer. Ajuster. Progresser.
      </h2>
      <p class="max-w-[58ch] text-mesure">
        Un bilan chiffré à la première séance, un programme revu chaque semaine, des séances notées et comparées.
      </p>
      <div>
        <Button variant="ghost" href="/methode">
          découvrir la méthode
        </Button>
      </div>
    </div>
  </section>

  <CtaBand index="04" />
</BaseLayout>
