---
import "@/styles/global.css";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site, siteTexts } from "@/data/site";
import { languages, localePath, locales } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Structured data (schema.org), serialised into a JSON-LD script */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

const { lang, path } = Astro.locals;
const t = ui[lang];
const suffix = { fr: "coach musculation", en: "strength coach", tr: "fitness koçu" }[lang];
const defaultDescription = {
  fr: "Coaching musculation et bodybuilding.",
  en: "Strength and bodybuilding coaching.",
  tr: "Fitness ve vücut geliştirme koçluğu.",
}[lang];
const { title, description = `${siteTexts[lang].tagline} ${defaultDescription}`, noindex = false, jsonLd } = Astro.props;
const fullTitle = title === site.brand ? `${site.brand} — ${suffix}` : `${title} — ${site.brand} ${suffix}`;
const canonical = new URL(localePath(lang, path), Astro.site);
// Same page in the other languages (hreflang), French as x-default
const alternates = locales.map((code) => ({ code, href: new URL(localePath(code, path), Astro.site).href }));
// "</" can't appear inside a script element: escape it in the JSON
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {locales
      .filter((code) => code !== lang)
      .map((code) => (
        <meta property="og:locale:alternate" content={languages[code].ogLocale} />
      ))}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={languages[alt.code].htmlLang} href={alt.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    {/* Arms the animations (docs/03-design-system.md §8) before the first
       paint, so nothing flashes. Not with reduced motion. If the motion
       script never runs, everything is shown again after 2.5 s. */}
    <script is:inline>
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const root = document.documentElement;
        root.classList.add("motion");
        setTimeout(() => {
          if (!window.__motion) root.classList.remove("motion");
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-graphite focus:px-4 focus:py-3 focus:text-white"
    >
      {t.skipLink}
    </a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <script>
      import { startMotion } from "@/lib/motion";
      startMotion();
    </script>
  </body>
</html>
