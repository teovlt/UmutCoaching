---
// docs/02-architecture.md § Accueil 00 Hero, texts from docs/04-contenu.md.
// Right column: Umut's photo (the one uploaded in /admin › Photos, else the
// bundled default). The illustrative ProgressChart is on /methode.
import Button from "@/components/ui/Button.astro";
import Specimen from "@/components/ui/Specimen.astro";
import UmutPicture from "@/components/ui/UmutPicture.astro";
import { umut } from "@/data/umut";
import type { Settings } from "@/lib/api";
import { localePath } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const { lang } = Astro.locals;
const t = ui[lang];
// Each word tips in after the previous one (docs/03-design-system.md §8)
const words = t.hero.words;
---

<section class="container-site grid items-center gap-12 py-12 lg:grid-cols-12 lg:gap-8 lg:py-20" aria-labelledby="hero-title">
  <div class="flex flex-col gap-8 lg:col-span-7">
    <p class="font-mono text-label text-mesure uppercase">{t.hero.kicker}</p>
    <h1 id="hero-title" class="text-h1">
      {words.map((word, i) => (
        <>
          <span class="hero-word" style={`--i: ${i}`}>
            {word}
          </span>{" "}
        </>
      ))}
    </h1>
    <p class="max-w-[52ch] text-lead text-mesure">
      {t.hero.lead.before}
      <span class="whitespace-nowrap">{settings.city}</span>
      {t.hero.lead.after}
    </p>
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href={localePath(lang, "/reserver")} icon="arrow">
          {t.booking}
        </Button>
        <Button variant="ghost" href={localePath(lang, "/programmes")}>
          {t.hero.seePrograms}
        </Button>
      </div>
      <p class="font-mono text-micro text-mesure">{t.hero.reply}</p>
    </div>
  </div>

  <div class="lg:col-span-5">
    <Specimen caption={t.hero.caption}>
      <UmutPicture uploaded={settings.photos.hero} fallback={umut.hero} priority class="border border-line" />
    </Specimen>
  </div>
</section>
