---
// docs/02-architecture.md § Accueil 00 Hero, texts from docs/04-contenu.md.
// Right column: Umut's photo once uploaded in /admin › Photos, otherwise a
// visible placeholder frame (the illustrative ProgressChart is on /methode).
import Button from "@/components/ui/Button.astro";
import PhotoPlaceholder from "@/components/ui/PhotoPlaceholder.astro";
import type { Settings } from "@/lib/api";

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const photo = settings.photos.hero;
---

<section class="container-site grid items-center gap-12 py-12 lg:grid-cols-12 lg:gap-8 lg:py-20" aria-labelledby="hero-title">
  <div class="flex flex-col gap-8 lg:col-span-7">
    <p class="font-mono text-label text-mesure uppercase">// coach · bodybuilding · data</p>
    <h1 id="hero-title" class="text-h1">
      Mesurer. Ajuster. Progresser.
    </h1>
    <p class="max-w-[52ch] text-lead text-mesure">
      Coaching musculation à <span class="whitespace-nowrap">{settings.city}</span> et en ligne. Un bilan de départ, un plan ajusté chaque
      semaine, une progression suivie au kilo près.
    </p>
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href="/reserver" icon="arrow">
          Réserver une séance
        </Button>
        <Button variant="ghost" href="/programmes">
          voir les programmes
        </Button>
      </div>
      <p class="font-mono text-micro text-mesure">→ réponse sous 24&nbsp;h</p>
    </div>
  </div>

  <div class="lg:col-span-5">
    {photo.url ? (
      <img
        src={photo.url}
        alt={photo.alt || "Umut, coach musculation"}
        width="800"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[4/5] w-full border border-line object-cover"
      />
    ) : (
      <PhotoPlaceholder label="photo d'Umut en salle" />
    )}
  </div>
</section>
