---
// docs/02-architecture.md § Accueil 02, texts from docs/04-contenu.md (Méthode).
import Button from "@/components/ui/Button.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { localePath } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  /** Section number, given by the page: "02" */
  index: string;
}

const { index } = Astro.props;
const { lang } = Astro.locals;
const t = ui[lang];
const steps = t.method.steps.map((step, i) => ({ ...step, index: String(i + 1).padStart(2, "0") }));
---

<section class="section" aria-labelledby="methode-title">
  <div class="container-site flex flex-col gap-12">
    <div class="flex flex-col gap-4">
      <SectionLabel index={index} label={t.sectionLabels.methode} />
      <h2 id="methode-title" class="max-w-[20ch] text-h2">
        {t.method.title}
      </h2>
    </div>
    <ol data-stagger class="grid gap-10 md:grid-cols-3 md:gap-8">
      {steps.map((step) => (
        <li class="flex flex-col gap-4 border-t border-graphite pt-5">
          <span class="font-mono text-data font-bold">{step.index}</span>
          <h3 class="text-h3">{step.title}</h3>
          <p class="text-mesure">{step.text}</p>
        </li>
      ))}
    </ol>
    <div>
      <Button variant="ghost" href={localePath(lang, "/methode")}>
        {t.method.more}
      </Button>
    </div>
  </div>
</section>
