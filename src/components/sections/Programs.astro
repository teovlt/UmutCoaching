---
// docs/02-architecture.md § Accueil 03: the visible programmes from the API.
import Button from "@/components/ui/Button.astro";
import ProgramCard from "@/components/ui/ProgramCard.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import type { Programme } from "@/lib/types";
import { localePath } from "@/i18n/config";
import { ui } from "@/i18n/ui";

interface Props {
  /** Section number, given by the page: "02" */
  index: string;
  programmes: Programme[];
}

const { programmes, index } = Astro.props;
const { lang } = Astro.locals;
const t = ui[lang];
---

<section class="section border-t border-line" aria-labelledby="programmes-title">
  <div class="container-site flex flex-col gap-12">
    <div class="flex flex-col gap-4">
      <SectionLabel index={index} label={t.sectionLabels.programmes} />
      <h2 id="programmes-title" class="text-h2">
        {t.programs.title}
      </h2>
    </div>
    {programmes.length > 0 ? (
      <ul data-stagger class:list={["grid gap-4 md:grid-cols-2", programmes.length >= 3 && "lg:grid-cols-3"]}>
        {programmes.map((programme, i) => (
          <li>
            <ProgramCard programme={programme} index={String(i + 1).padStart(2, "0")} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="font-mono text-small text-mesure">{t.programs.empty}</p>
    )}
    <div>
      <Button variant="ghost" href={localePath(lang, "/programmes")}>
        {t.programs.all}
      </Button>
    </div>
  </div>
</section>
