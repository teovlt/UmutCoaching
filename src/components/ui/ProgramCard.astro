---
// docs/03-design-system.md §6 ProgramCard: .card, mono index top left,
// StatusBadge top right, H3, summary, mono meta, price, ghost link.
// Hover: graphite border.
import Button from "@/components/ui/Button.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { priceText, programmeMeta } from "@/lib/format";
import type { Programme } from "@/lib/types";

interface Props {
  programme: Programme;
  /** "01", "02"… */
  index: string;
  class?: string | undefined;
}

const { programme: p, index, class: className } = Astro.props;
const href = `/programmes/${p.slug}`;
---

<article class:list={["card flex h-full flex-col gap-5 p-6 transition-colors duration-120 ease-labo hover:border-graphite", className]}>
  <div class="flex items-start justify-between gap-4">
    <span class="font-mono text-label text-mesure">{index}</span>
    {p.status && <StatusBadge status={p.status} />}
  </div>
  <div class="flex flex-col gap-3">
    <h3 class="text-h3">{p.title}</h3>
    {p.summary && <p class="text-small text-mesure">{p.summary}</p>}
  </div>
  <p class="font-mono text-label text-mesure uppercase">{programmeMeta(p)}</p>
  <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-line pt-4">
    <p class="font-mono font-bold">{priceText(p)}</p>
    <Button variant="ghost" href={href} attrs={{ "aria-label": `Voir le détail : ${p.title}` }}>
      voir le détail
    </Button>
  </div>
</article>
