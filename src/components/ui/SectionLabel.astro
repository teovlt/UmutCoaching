---
// docs/03-design-system.md §6 SectionLabel: `02 / programmes ———`.
// Rendered as a <p> by default; pass `as="h2"` when it titles a section that
// has no other heading.
interface Props {
  index: string;
  label: string;
  as?: "p" | "h2" | "h3" | "span" | undefined;
  id?: string | undefined;
  class?: string | undefined;
}

const { index, label, as: Element = "p", id, class: className } = Astro.props;
---

<Element id={id} class:list={["section-label", className]}>
  {index} / {label}
</Element>
