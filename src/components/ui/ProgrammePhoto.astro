---
// A programme's 3:2 picture: the photo uploaded in /admin if any (already
// WebP from the API, D19), else Umut's default photo for this offer
// (src/data/umut.ts, a different one per offer), optimised by astro:assets, in colour.
import { Image } from "astro:assets";
import { programmeDefault } from "@/data/umut";
import type { Programme } from "@/lib/types";

interface Props {
  programme: Pick<Programme, "image" | "slug" | "title">;
  /** Rendered width hint for srcset, in CSS px */
  sizes?: string | undefined;
  loading?: "lazy" | "eager" | undefined;
  class?: string | undefined;
}

const {
  programme: p,
  sizes = "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw",
  loading = "lazy",
  class: className,
} = Astro.props;
const fallback = programmeDefault(p.slug);
const classes = ["aspect-[3/2] w-full object-cover", className];
---

{p.image.url ? (
  <img src={p.image.url} alt={p.image.alt || p.title} width="900" height="600" loading={loading} decoding="async" class:list={classes} />
) : (
  <Image
    src={fallback.src}
    alt={fallback.alt[Astro.locals.lang]}
    widths={[480, 800, 1200]}
    sizes={sizes}
    loading={loading}
    class:list={classes}
  />
)}
