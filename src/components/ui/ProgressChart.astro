---
// docs/03-design-system.md §6 ProgressChart: the logo's curve as a progress
// chart. Data shown here is illustrative, so the caption must say so
// ("exemple de suivi"). The line draws itself once when it scrolls into view;
// without JavaScript, or with reduced motion, it is simply shown.
interface Point {
  label: string;
  value: number;
}

interface Props {
  points: Point[];
  unit?: string | undefined;
  caption: string;
  /** Accessible summary, e.g. "Développé couché : de 80 kg en S01 à 100 kg en S12" */
  title: string;
  class?: string | undefined;
}

const { points, unit = "", caption, title, class: className } = Astro.props;

const width = 600;
const height = 280;
const pad = { top: 24, right: 28, bottom: 44, left: 92 };
const plotW = width - pad.left - pad.right;
const plotH = height - pad.top - pad.bottom;

const values = points.map((p) => p.value);
const rawMin = Math.min(...values);
const rawMax = Math.max(...values);
const span = rawMax - rawMin || 1;
const min = rawMin - span * 0.1;
const max = rawMax + span * 0.1;

const x = (i: number) => pad.left + (points.length > 1 ? (i / (points.length - 1)) * plotW : plotW / 2);
const y = (v: number) => pad.top + plotH - ((v - min) / (max - min)) * plotH;

const coords = points.map((p, i) => `${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(" ");
const last = points.length - 1;
const ticks = [rawMin, (rawMin + rawMax) / 2, rawMax];
const format = (v: number) => `${Math.round(v)}${unit ? ` ${unit}` : ""}`;
const first = points[0];
const end = points[last];
// SVG user units, not CSS px: the chart scales with its width, so labels are
// drawn larger than 11 px to stay readable once shrunk on a phone
const labelSize = 20;
// Every label on wide data would collide on a phone: show one in two past 8 points
const labelEvery = points.length > 8 ? 2 : 1;
const titleId = `chart-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class:list={["card flex flex-col gap-4 p-5 on-dark:border-line-dark on-dark:bg-graphite", className]} data-progress-chart>
  <svg viewBox={`0 0 ${width} ${height}`} class="h-auto w-full" role="img" aria-labelledby={titleId}>
    <title id={titleId}>{title}</title>
    {ticks.map((t) => (
      <g>
        <line x1={pad.left} x2={width - pad.right} y1={y(t)} y2={y(t)} class="stroke-line on-dark:stroke-line-dark" stroke-width="1" />
        <text
          x={pad.left - 10}
          y={y(t)}
          text-anchor="end"
          dominant-baseline="middle"
          font-size={labelSize}
          class="fill-mesure font-mono on-dark:fill-muted"
        >
          {format(t)}
        </text>
      </g>
    ))}
    <line
      x1={pad.left}
      x2={width - pad.right}
      y1={pad.top + plotH}
      y2={pad.top + plotH}
      class="stroke-graphite on-dark:stroke-edge-dark"
      stroke-width="1"
    />
    {points.map(
      (p, i) =>
        (i === 0 || i === last || (i % labelEvery === 0 && last - i >= labelEvery)) && (
          <text x={x(i)} y={height - 12} text-anchor="middle" font-size={labelSize} class="fill-mesure font-mono on-dark:fill-muted">
            {p.label}
          </text>
        ),
    )}
    <polyline
      points={coords}
      fill="none"
      class="chart-line stroke-cobalt-500 on-dark:stroke-cobalt-400"
      stroke-width="4"
      stroke-linejoin="round"
      pathLength="1"
    />
    {end && <circle cx={x(last)} cy={y(end.value)} r="8" class="chart-dot fill-cobalt-500 on-dark:fill-cobalt-400" />}
  </svg>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 font-mono text-label">
    <span class="text-mesure uppercase on-dark:text-muted">{caption}</span>
    {first && end && (
      <span class="font-bold text-graphite on-dark:text-white">
        {first.label} {format(first.value)} → {end.label} {format(end.value)}
      </span>
    )}
  </figcaption>
</figure>

<style>
  /* Hidden only once the script has armed the chart, so it never stays blank */
  [data-progress-chart][data-armed] .chart-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  [data-progress-chart][data-armed] .chart-dot {
    opacity: 0;
  }
  [data-progress-chart][data-drawn] .chart-line {
    --path-length: 1;
    animation: var(--animate-draw);
  }
  [data-progress-chart][data-drawn] .chart-dot {
    opacity: 1;
    transition: opacity var(--duration-base) var(--ease-labo) 1.1s;
  }
</style>

<script>
  const charts = document.querySelectorAll<HTMLElement>("[data-progress-chart]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.drawn = "";
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.4 },
    );
    for (const chart of charts) {
      chart.dataset.armed = "";
      observer.observe(chart);
    }
  }
</script>
