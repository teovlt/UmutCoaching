---
// docs/02-architecture.md § Header & navigation. Sticky, white, 1 px bottom
// rule, no shadow. Desktop (≥ 1024): symbol + wordmark, numbered mono links,
// language switcher, dark CTA with a cobalt dot (the solid cobalt is kept for
// the page's main CTA). Below 1024: wordmark, language switcher and the square
// menu button opening MobileMenu.
import SymbolSmall from "@/assets/brand/umut-symbol-small.svg";
import Button from "@/components/ui/Button.astro";
import { bookingHref, isActive, mainNav } from "@/data/navigation";
import { localePath } from "@/i18n/config";
import { ui } from "@/i18n/ui";
import LangSwitcher from "./LangSwitcher.astro";
import MobileMenu from "./MobileMenu.astro";

const { lang, path } = Astro.locals;
const t = ui[lang];
---

<header class="sticky top-0 z-40 border-b border-line bg-white">
  <div class="container-site flex h-16 items-center justify-between gap-4 lg:h-19 xl:gap-6">
    <a
      href={localePath(lang, "/")}
      class="flex items-center gap-2.5 text-graphite no-underline hover:text-graphite"
      aria-label={t.homeLabel}
    >
      <SymbolSmall class="hidden size-8 lg:block" aria-hidden="true" />
      <span class="text-h3 font-bold" aria-hidden="true">
        umut<span class="brand-dot">.</span>
      </span>
    </a>

    <nav aria-label={t.mainNavLabel} class="hidden lg:block">
      <ul class="flex items-center gap-5 font-mono text-small xl:gap-8">
        {mainNav.map((item) => {
          const active = isActive(path, item.href);
          return (
            <li>
              <a
                href={localePath(lang, item.href)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "inline-flex min-h-11 items-center whitespace-nowrap no-underline hover:underline",
                  active ? "text-cobalt-500" : "text-graphite hover:text-graphite",
                ]}
              >
                {item.index} {t.nav[item.key]}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:gap-4">
      <LangSwitcher />
      <div class="hidden lg:block">
        <Button variant="dark" dot href={localePath(lang, bookingHref)} class="whitespace-nowrap">
          {t.booking}
        </Button>
      </div>
      <MobileMenu />
    </div>
  </div>
</header>
