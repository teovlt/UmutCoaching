---
// docs/02-architecture.md § Accueil (Footer) and docs/04-contenu.md § Footer.
// Graphite, 4 columns on desktop, line-dark rules. Unconfirmed details stay as
// visible [À CONFIRMER] placeholders; a social network without a URL is shown
// as text, not as a dead link.
import { isPlaceholder, site } from "@/data/site";
import { bookingCta, legalNav, mainNav } from "@/data/navigation";

const year = new Date().getFullYear();
const phoneHref = isPlaceholder(site.phone) ? undefined : `tel:${site.phone.replace(/[^+\d]/g, "")}`;
const emailHref = isPlaceholder(site.email) ? undefined : `mailto:${site.email}`;
---

<footer class="on-dark border-t border-line-dark">
  <div class="container-site grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <div class="flex flex-col gap-3">
      <a href="/" class="text-h2 font-bold text-white no-underline" aria-label="umut. — accueil">
        <span aria-hidden="true">
          umut<span class="brand-dot">.</span>
        </span>
      </a>
      <p class="font-mono text-label text-muted uppercase">{site.descriptor}</p>
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="label-mono text-muted">Contact</h2>
      <address class="flex flex-col gap-1 text-small not-italic">
        <span>{site.gym}</span>
        <span>{site.address}</span>
        {phoneHref ? <a href={phoneHref}>{site.phone}</a> : <span>{site.phone}</span>}
        {emailHref ? <a href={emailHref}>{site.email}</a> : <span>{site.email}</span>}
      </address>
      <p class="font-mono text-label text-muted">{site.hours}</p>
    </div>

    <nav aria-label="Pied de page" class="flex flex-col gap-3">
      <h2 class="label-mono text-muted">Pages</h2>
      <ul class="flex flex-col gap-1 text-small">
        {mainNav.map((item) => (
          <li>
            <a href={item.href} class="inline-flex min-h-11 items-center gap-2 no-underline hover:underline lg:min-h-0">
              <span class="font-mono text-label text-muted">{item.index}</span>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={bookingCta.href}
            class="inline-flex min-h-11 items-center font-bold text-cobalt-400 no-underline hover:underline lg:min-h-0"
          >
            {bookingCta.label} →
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex flex-col gap-3">
      <h2 class="label-mono text-muted">Réseaux</h2>
      <ul class="flex flex-col gap-1 text-small">
        {site.socials.map((social) => (
          <li>
            {social.url ? (
              <a href={social.url} rel="me noopener" target="_blank" class="inline-flex min-h-11 items-center lg:min-h-0">
                {social.label}
              </a>
            ) : (
              <span>
                {social.label} <span class="font-mono text-label text-muted">[À CONFIRMER]</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-line-dark">
    <div class="container-site flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-label text-muted">© {year} umut.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 text-small">
        {legalNav.map((item) => (
          <li>
            <a href={item.href} class="inline-flex min-h-11 items-center sm:min-h-0">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
