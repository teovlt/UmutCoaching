# Copied by Dokploy's "Environment" tab into the .env read by docker-compose.yml

# Public address of the site (canonical URLs, sitemap). Read at build time
SITE_URL=https://umut.example

# API
MONGODB_URI=mongodb://user:password@host:27017/umut?authSource=admin
JWT_SECRET=change-me-to-a-long-random-string

# Local development only: where the Astro dev server reaches the API
API_URL=http://localhost:4000
