# Copié dans l'onglet « Environment » de Dokploy, qui écrit le .env lu par compose.yaml.

# --- Obligatoire -----------------------------------------------------------
# Adresse publique du site (URL canoniques, sitemap). Lue au build : redéployer après un changement.
# Exemple en sous-domaine : https://umut.mondomaine.fr
SITE_URL=https://umut.example

# Base MongoDB (base « Mongo » créée dans le même projet Dokploy : URI interne ; ou Atlas).
# Si le DNS du VPS ne résout pas les URI « mongodb+srv:// », utiliser la forme « mongodb:// »
# avec la liste des serveurs du cluster (voir README › Dépannage).
MONGODB_URI=mongodb://utilisateur:motdepasse@hote:27017/umut?authSource=admin

# Secret de signature des sessions admin. Générer avec : openssl rand -hex 32
JWT_SECRET=

# --- Développement local uniquement -----------------------------------------
# Où le serveur de dev Astro joint l'API (en production : http://umut-api:4000, fixé dans compose.yaml)
API_URL=http://localhost:4000
